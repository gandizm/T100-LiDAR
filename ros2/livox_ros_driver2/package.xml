<?xml version="1.0"?>
<package format="3">
  <name>livox_ros_driver2</name>
  <version>0.1.0</version>
  <description>
    T100 Ethernet/UDP driver publishing the Livox ROS Driver2 CustomMsg and IMU
    interfaces for compatible ROS2 SLAM consumers.
  </description>
  <maintainer email="58645849+gandizm@users.noreply.github.com">gandizm</maintainer>
  <license>T100 Non-Commercial License 1.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>builtin_interfaces</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>

  <exec_depend>rosidl_default_runtime</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
