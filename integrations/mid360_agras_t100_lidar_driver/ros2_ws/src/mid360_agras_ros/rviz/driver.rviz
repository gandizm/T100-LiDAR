Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 40
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Name: Mid-360
      Enabled: true
      Topic:
        Value: /livox/points
        Depth: 5
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
      Style: Points
      Size (Pixels): 2
      Color Transformer: Intensity
      Decay Time: 0.5
      Value: true
  Enabled: true
  Global Options:
    Background Color: 20; 22; 26
    Fixed Frame: livox_frame
    Frame Rate: 30
  Name: root
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 25
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Name: Current View
      Pitch: 0.8
      Yaw: 3.14
      Value: Orbit (rviz)
    Saved: ~
Window Geometry:
  Height: 800
  Width: 1200
